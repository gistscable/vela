{
  "name": "fmb-banking-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Fictional retail-banking product demo",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "npm run prisma:generate && next build",
    "start": "next start -H 0.0.0.0",
    "db:setup": "npm run prisma:generate && node scripts/prisma.mjs db push --skip-generate && tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:push": "node scripts/prisma.mjs db push",
    "db:migrate:deploy": "node scripts/prisma.mjs migrate deploy",
    "admin:grant": "node scripts/admin-grant.mjs",
    "prisma:generate": "node scripts/prisma.mjs generate",
    "e2e": "node e2e/run.mjs",
    "db:backfill-history": "tsx scripts/backfill-history.ts",
    "db:backfill-history:apply": "tsx scripts/backfill-history.ts --apply",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:verify:pre": "node scripts/verify-migration-state.mjs pre",
    "db:verify:post": "node scripts/verify-migration-state.mjs post"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "jose": "^6.0.10",
    "lucide-react": "^0.487.0",
    "next": "^15.5.4",
    "plaid": "^48.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-plaid-link": "^5.0.0",
    "stripe": "^23.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "postcss": "^8.5.3",
    "prisma": "^6.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  }
}
